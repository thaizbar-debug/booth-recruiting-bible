# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.

# GitHub personal access token — needed only for LOCAL runs.
# In GitHub Actions this is injected automatically (no setup needed).
# Create one free at: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# Required permission: Models (read)
GITHUB_TOKEN=github_pat_...

# Gmail address you're sending FROM
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password — 16 characters, no spaces
# How to create: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who receives the daily briefing (defaults to thaizbar@gmail.com if omitted)
RECIPIENT_EMAIL=thaizbar@gmail.com

# Local folder for .txt copies (relative to the daily-briefing/ directory)
SAVE_DIR=./daily-summaries

# AI model to use via GitHub Models (default: gpt-4o-mini)
GITHUB_MODEL=gpt-4o-mini
