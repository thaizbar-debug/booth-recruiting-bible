# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.

# Anthropic API key — used to call Claude for briefing generation.
# Create one at https://console.anthropic.com under API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Gmail address you're sending FROM
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password — 16 characters, no spaces
# How to create: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who receives the daily briefing (defaults to thaizbar@gmail.com if omitted)
RECIPIENT_EMAIL=thaizbar@gmail.com

# Local folder for .txt copies (relative to the daily-briefing/ directory)
SAVE_DIR=./daily-summaries

# Anthropic model ID (default: claude-opus-4-7)
# Alternatives: claude-sonnet-4-6 (~5x cheaper), claude-haiku-4-5 (~15x cheaper)
ANTHROPIC_MODEL=claude-opus-4-7
