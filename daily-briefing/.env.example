# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.

# Google Gemini API key — used to call Gemini for briefing generation.
# Free tier is generous; create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Gmail address you're sending FROM
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password — 16 characters, no spaces
# How to create: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who receives the daily briefing (defaults to thaizbar@gmail.com if omitted)
RECIPIENT_EMAIL=thaizbar@gmail.com

# Local folder for .txt copies (relative to the daily-briefing/ directory)
SAVE_DIR=./daily-summaries

# Gemini model ID (default: gemini-3.5-flash-lite — cheapest current model)
# Alternatives: gemini-3.5-flash, gemini-3.6-flash (higher quality, may have stricter limits)
GEMINI_MODEL=gemini-3.5-flash-lite
